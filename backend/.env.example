# Copy to backend/.env and configure one provider. AI stages remain disabled without a key.
# AI_PROVIDER is optional when only one provider is configured.
AI_PROVIDER=deepseek

# DeepSeek: text model for semantic correction, summary and Q&A.
# The local computer-vision layout analyzer remains responsible for page images.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Anthropic (optional alternative)
# AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# OpenAI or another OpenAI-compatible provider (optional alternative)
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o
# OPENAI_BASE_URL=

FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=false
WORKFLOW_WORKERS=2
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
OCR_USE_GPU=false
