FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=false
WORKFLOW_WORKERS=2
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
OCR_USE_GPU=false
