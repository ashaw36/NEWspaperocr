@echo off
chcp 65001 >nul
echo ================================================================================
echo 古报纸OCR识别系统 - 一键启动
echo ================================================================================
echo.

cd /d "%~dp0backend"

echo [1/2] 正在启动后端服务...
start "古报纸OCR后端" cmd /k "py app.py"
timeout /t 3 >nul

echo [2/2] 正在启动前端服务...
cd ..\frontend
start "古报纸OCR前端" cmd /k "py -m http.server 8080"
timeout /t 2 >nul

echo.
echo ================================================================================
echo 系统启动完成！
echo ================================================================================
echo.
echo 后端服务: http://127.0.0.1:5000
echo 前端界面: http://127.0.0.1:8080
echo.
echo 请在浏览器中打开: http://127.0.0.1:8080
echo.
echo 按任意键打开浏览器...
pause >nul

start http://127.0.0.1:8080

echo.
echo 提示: 关闭此窗口不会停止服务，请手动关闭两个命令行窗口
pause
